<div class="container">

<h1>Editing Subject</h1>

<%= render 'form', subject: @subject %>

<div class="btn-group">
	<%= link_to 'Show', @subject, class: "btn btn-primary" %>
	<%= link_to 'List', subjects_path, class: "btn btn-outline-dark" %>
	<%= button_to 'Destroy', @subject, method: :delete, form: { data: { confirm: 'Are you sure?' } }, form_class: "btn-group", class: "btn btn-danger" %>
</div>

</div>